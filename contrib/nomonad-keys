#!/bin/sh
cfg="${XDG_CONFIG_HOME:-$HOME/.config}/nomonad/config.scm"
nm="${NOMONAD:-nomonad}"
mark='@@nomonad-keys@@'
{
	"$nm" --describe 2>/dev/null
	printf '\n%s\n' "$mark"
	cat "$cfg"
} | awk -v mark="$mark" '
function esc(s) {
	gsub(/&/, "\\&amp;", s)
	gsub(/</, "\\&lt;", s)
	gsub(/>/, "\\&gt;", s)
	return s
}
!cfgmode {
	if ($0 == mark) { cfgmode = 1; next }
	if ($1 == "(action") { name = $2; next }
	if (name != "" && $1 == ":doc") {
		d = $0
		sub(/^[ \t]*:doc "/, "", d)
		sub(/"\)+$/, "", d)
		gsub(/\\"/, "\"", d)
		gsub(/\\\\/, "\\", d)
		doc[name] = d
		name = ""
	}
	next
}
{
	line = $0 " "
	for (i = 1; i <= length(line); i++) {
		c = substr(line, i, 1)
		if (instr && c == "\\") {
			c = c substr(line, ++i, 1)
		} else if (c == "\"") {
			instr = !instr
		} else if (!instr && c == ";") {
			break
		}
		if (!instr && c == "(") {
			depth++
			if (depth == 1) { top = ""; continue }
			if (depth == 2) {
				n = split(top, w, " ")
				prefix = ""
				if (w[1] == "defmouse") prefix = "mouse "
				if (w[1] == "defsubmap") prefix = "submap " w[2] " "
				keep = (w[1] == "defkeys" || w[1] == "defmouse" || w[1] == "defsubmap")
				entry = ""
				atom = 0
				act = ""
			}
			if (depth == 3) { want = 1; act = ""; atom = 0 }
		} else if (depth == 2 && c ~ /[ \t]/) {
			atom = 0
		} else if (depth == 2 && c != ")") {
			if (!atom) { act = ""; atom = 1 }
			act = act c
		} else if (depth == 3 && want) {
			if (c ~ /[ \t)]/) want = 0
			else act = act c
		}
		if (depth == 1) top = top c
		if (depth >= 2) entry = entry c
		if (!instr && c == ")") {
			if (depth == 2 && keep) {
				gsub(/[ \t]+/, " ", entry)
				out = esc(prefix entry)
				if (act != "spawn" && (act in doc))
					out = out "   <span alpha=\"55%\">" esc(doc[act]) "</span>"
				print out
			}
			depth--
		}
	}
}
' | rofi -dmenu -i -markup-rows -p keys >/dev/null
exit 0
